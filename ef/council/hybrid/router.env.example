# Server only. Generate TWO different values: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HYBRID_STATION_KEY=REPLACE_WITH_RANDOM_STATION_SECRET
HYBRID_BRIDGE_KEY=REPLACE_WITH_DIFFERENT_RANDOM_BRIDGE_SECRET
HYBRID_BRIDGE_ORIGIN=https://ric-model-bridge.example.test
HYBRID_PORT=8899
HYBRID_LOCAL_TIMEOUT_MS=90000
HYBRID_CLOUD_TIMEOUT_MS=120000
HYBRID_MAX_OUTPUT_TOKENS=2048
HYBRID_CONTEXT_LENGTH=8192
HYBRID_MAX_IN_FLIGHT=2
# Explicit opt-in after provider billing limit is set. Examples intentionally have no working credentials.
HYBRID_CLOUD_ENABLED=false
HYBRID_CLOUD_BASE_URL=https://YOUR_PROVIDER.example.test/v1
HYBRID_CLOUD_KEY=REPLACE_WITH_PROVIDER_KEY
HYBRID_CLOUD_MODEL=REPLACE_WITH_TOOL_CAPABLE_MODEL_ID
